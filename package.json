{
  "name": "fast-building",
  "version": "0.1.0",
  "private": true,
  "description": "快速构建建筑平台（Blender 无头建模 + Web 工作台）",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "prod": "node scripts/dev.mjs --prod",
    "api": "node scripts/dev.mjs --only api",
    "web": "node scripts/dev.mjs --only web",
    "build": "node scripts/dev.mjs --build",
    "typecheck": "npm --prefix frontend run typecheck"
  }
}
